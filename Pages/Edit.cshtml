@page
@model EditModel

<div class="app-card">
    <h1 class="app-title">Edit Task</h1>

    <form method="post" class="add-form">
        <input type="hidden" asp-for="Id" />
        <input asp-for="Title" class="add-input" />
        <button type="submit" class="pill pill-add">Save</button>
        <a asp-page="Index" class="pill pill-edit">Cancel</a>
    </form>
</div>