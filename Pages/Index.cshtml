@page
@model IndexModel


<div class="app-card">
    <h1 class="app-title">My Tasks</h1>

    <form method="post" asp-page-handler="Add" class="add-form">
        <input asp-for="NewTitle" placeholder="What do you need to do?" class="add-input" />
        <button type="submit" class="pill pill-add">Add Task</button>
    </form>

    <ul class="task-list">
        @foreach (var task in Model.Tasks)
        {
            <li class="task-row @(task.IsDone ? "is-done" : "")">
                <span class="task-title">@task.Title</span>

                @if (task.IsDone)
                {
                    <strong class="done-label">(Done)</strong>
                }

                <div class="task-actions">
                    <a asp-page="Edit" asp-route-id="@task.Id" class="pill pill-edit">Edit</a>

                    <form method="post" asp-page-handler="Toggle" asp-route-id="@task.Id">
                        <button type="submit" class="pill pill-toggle">@(task.IsDone ? "Undo" : "Done")</button>
                    </form>

                    <form method="post" asp-page-handler="Delete" asp-route-id="@task.Id">
                        <button type="submit" class="pill pill-delete">Delete</button>
                    </form>
                </div>
            </li>
        }
    </ul>
</div>