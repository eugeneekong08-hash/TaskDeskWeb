@page
@model IndexModel

<h1>My Tasks</h1>

<form method="post" asp-page-handler="Add">
    <input asp-for="NewTitle" placeholder="What do you need to do?" />
    <button type="submit">Add Task</button>
</form>

<ul>
    @foreach (var task in Model.Tasks)
    {
        <li>
            @task.Title

            @if (task.IsDone)
            {
                <strong>(Done)</strong>
            }

            <a asp-page="Edit" asp-route-id="@task.Id">Edit</a> <!-- NEW LINE -->

            <form method="post" asp-page-handler="Toggle" asp-route-id="@task.Id">
                <button type="submit">@(task.IsDone ? "Undo" : "Done")</button>
            </form>

            <form method="post" asp-page-handler="Delete" asp-route-id="@task.Id">
                <button type="submit">Delete</button>
            </form>
        </li>
    }